# DraftIn API (mantida exclusivamente no servidor — nunca use prefixo VITE_ para a chave)
DRAFTIN_API_KEY=dra_xxxxxxxxxxxxxxxxxxxxxxxxxxx
DRAFTIN_BASE_URL=https://api.draftin.io

# Servidor / SEO
PORT=4173
SITE_URL=http://localhost:4173
DRAFTIN_CACHE_TTL_MS=60000

# Identidade configurável do blog (público)
VITE_BLOG_TITLE=Caderno de Notas
VITE_BLOG_TAGLINE=Ensaios sobre tecnologia, arquitetura de software e design editorial.
VITE_BLOG_AUTHOR=
VITE_BLOG_INTRO_ENABLED=true
VITE_BLOG_INTRO_HEADING=Pensamento escrito sem ruído.
VITE_BLOG_INTRO_BODY=Um espaço independente dedicado a textos longos, ideias em maturação e notas técnicas — publicado com sobriedade e rigor tipográfico.

# YouTube Playlist ID para o player de música flutuante (basta definir uma das duas)
YOUTUBE_PLAYLIST_ID=PLMC9KNkIncKtPzgY-5rmhvj7fax8fdxoj
VITE_YOUTUBE_PLAYLIST_ID=PLMC9KNkIncKtPzgY-5rmhvj7fax8fdxoj

